# Compose host identity. Set these to the owner of the NAS media mount.
CUE_PUID=1000
CUE_PGID=1000

# The Compose configuration normally loads secrets from this root-readable
# host file; do not place real credentials in this repository.
CUE_ENV_FILE=/etc/homelab/cue.env
CUE_COOKIES_FILE=/etc/homelab/cue.cookies.txt

# Absolute host path to Cue's one media root. Collection paths are relative to
# this root and validated by the application.
CUE_MEDIA_DIR=/mnt/nas/media/Music Videos
CUE_PORT=8080

# Set a long, unique secret in the host-managed service environment file.
# CUE_SESSION_SECRET=replace-this-with-a-random-secret

# Set these together only for the first Cue startup. The password is hashed and
# the values may then be removed from the environment file.
# CUE_BOOTSTRAP_ADMIN_USERNAME=cue-admin
# CUE_BOOTSTRAP_ADMIN_PASSWORD=replace-this-password

# SQLite state. The Compose default is sqlite:////data/cue.sqlite3.
# CUE_DATABASE_URL=sqlite:////data/cue.sqlite3

# Optional fast local workspace for completed downloads before final NAS staging.
# CUE_DOWNLOAD_WORKSPACE=/var/lib/cue-downloads

# Initial safety limit; this will later be configurable in the dashboard.
CUE_DEFAULT_DOWNLOAD_BATCH_SIZE=25

# SQLite online backups are created daily by the worker under Cue's persistent
# data volume. The retention count is in days.
# CUE_BACKUP_ROOT=/data/backups
# CUE_BACKUP_RETENTION_DAYS=30

# Cue stores generated M3U8 files and missing-item reports here inside its
# persistent data volume. Set this optional prefix to the media path your
# player sees (for example /mnt/nas/media/Music Videos); without it, M3U entries
# use paths relative to the media root.
# CUE_M3U_PATH_PREFIX=/mnt/nas/media/Music Videos

# Optional self-hosted Apprise endpoint for review/failure notifications.
# CUE_APPRISE_URL=http://apprise:8000/notify
